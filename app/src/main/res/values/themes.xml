<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="Theme.Slug" parent="android:Theme.Material.Light.NoActionBar" />


    <style name="Theme.Slug.TranslucentActivity" parent="Theme.Slug">
        <item name="android:background">@android:color/transparent</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowFullscreen">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:colorBackgroundCacheHint">@null</item>
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:backgroundDimEnabled">true</item>
    </style>

    <style name="Theme.Slug.OssLicenses" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="colorPrimary">@color/black</item>
        <item name="colorPrimaryDark">@color/black</item>
        <item name="colorAccent">@color/white</item>
        <!-- 라이선스 본문의 링크는 기본으로 colorAccent(흰색)를 따라 밝은 화면에서 보이지 않는다 — 본문 글자색을 쓴다 -->
        <item name="android:textColorLink">?android:attr/textColorPrimary</item>
    </style>
</resources>